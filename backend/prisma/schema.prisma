// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SECRETARY
  DOCTOR
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum ConsentFormStatus {
  SIGNED
  PENDING
  MISSING
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  REVIEW_PENDING
  POSTPONED
}

enum TreatmentPlanPriority {
  HIGH
  NORMAL
  LOW
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  patients     Patient[]
  doctors      Doctor[]
  appointments   Appointment[]
  payments       Payment[]
  consentForms   ConsentForm[]
  treatmentPlans TreatmentPlan[]
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  doctorProfile Doctor?

  @@index([clinicId])
}

model Patient {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String
  nationalId String?
  phone      String?
  email      String?
  birthDate  DateTime?
  gender     String?
  address    String?
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments   Appointment[]
  payments       Payment[]
  consentForms   ConsentForm[]
  treatmentPlans TreatmentPlan[]

  @@index([clinicId])
  @@index([clinicId, isActive])
  @@index([clinicId, lastName])
}

model Doctor {
  id            String   @id @default(uuid())
  fullName      String
  specialty     String?
  phone         String?
  email         String?
  licenseNumber String?
  room          String?
  color         String?
  bio           String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]

  @@index([clinicId])
  @@index([clinicId, isActive])
  @@index([clinicId, fullName])
}

model Appointment {
  id        String            @id @default(uuid())
  title     String?
  reason    String?
  startAt   DateTime
  endAt     DateTime
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  payments  Payment[]

  @@index([clinicId])
  @@index([clinicId, startAt])
  @@index([clinicId, doctorId, startAt])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@index([clinicId, isActive])
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime      @default(now())
  note          String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinicId      String
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([clinicId, patientId])
  @@index([clinicId, appointmentId])
  @@index([clinicId, paymentDate])
  @@index([clinicId, isActive])
}

model ConsentForm {
  id        String            @id @default(uuid())
  title     String
  formType  String
  content   String
  status    ConsentFormStatus @default(PENDING)
  signedAt  DateTime?
  note      String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@index([clinicId, isActive])
  @@index([clinicId, createdAt])
}

model TreatmentPlan {
  id          String                @id @default(uuid())
  description String
  priority    TreatmentPlanPriority @default(NORMAL)
  status      TreatmentPlanStatus   @default(ACTIVE)
  startDate   DateTime
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([clinicId, patientId])
  @@index([clinicId, doctorId])
  @@index([clinicId, status])
  @@index([clinicId, priority])
  @@index([clinicId, isActive])
  @@index([clinicId, startDate])
}
